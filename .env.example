# attendance_system 環境変数サンプル
# このファイルを .env にコピーして値を埋める (.env はコミットされない)。
# cPanel の「Setup Python App」を使う場合、パネルの環境変数 UI でも同じ値を設定できる。

# ── 必須 ───────────────────────────────────────────────────────────────────────
# 未設定でも起動はするが、その場合は .secret_key / .jwt_secret に自動生成される。
# 複数サーバー構成やコンテナ再作成で値を保持したい場合は必ず明示指定する。
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# ── DB ─────────────────────────────────────────────────────────────────────────
# 未設定なら instance/attendance.db (SQLite) を使う。
# 永続ボリュームへ逃がす場合は絶対パスで指定する (スラッシュ 4 本に注意)。
# DATABASE_URL=sqlite:////home/USER/attendance_data/attendance.db
DATABASE_URL=

# ── 公開 URL ───────────────────────────────────────────────────────────────────
# Discord 通知内のリンク生成などに使う。末尾スラッシュなし。
APP_PUBLIC_URL=https://example.com

# ── ログイン試行制限 ───────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30

# ── Discord 連携 (任意・未設定なら該当機能が無効になるだけ) ────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_HIGH=
DISCORD_ROLE_MID=
DISCORD_ROLE_LOW=
